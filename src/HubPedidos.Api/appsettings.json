{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Importacao": {
    "TamanhoMaximoDaLinha": 8192,
    "TamanhoMaximoTotal": 10485760,
    "TamanhoDoBuffer": 16384,
    "LimparAoDevolver": true,
    "ResultadosPorEscrita": 100
  },
  "Fila": {
    "Capacidade": 100,
    "ModoQuandoCheia": "Wait",
    "Consumidores": 4,
    "LimiteDeAcessoAoBanco": 1,
    "DuracaoSimuladaEmMs": 20,
    "PrazoDeEncerramentoEmSegundos": 15
  }
}
